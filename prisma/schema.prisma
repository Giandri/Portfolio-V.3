generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  DRAFT
  PUBLISHED
}

/// Kolom `Json` bertipe `Localized` (lihat src/lib/validations/localized.ts).
/// Isi dengan `pickLocalized`/`pickLocalizedList` saat membacanya.

model Profile {
  id              String   @id @default("singleton")
  name            String
  headline        Json // Localized
  roles           Json // LocalizedList
  location        Json? // Localized
  longBio         Json? // Localized
  publicEmail     String?
  resumeUrl       String?
  resumeFileName  String?
  avatarUrl       String?
  greetingOpening Json? // Localized, mis. "dear visitor,"
  greetingClosing Json? // Localized, mis. "warmly,"
  ctaLabel        Json? // Localized, mis. "Get in touch"
  updatedAt       DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     Json // Localized
  summary   Json // Localized
  thumbnail String?
  videoUrl  String?
  demoUrl   String?
  featured  Boolean  @default(false)
  status    Status   @default(DRAFT)
  order     Int      @default(0)
  skills    ProjectSkill[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, order])
}

model Skill {
  id        String         @id @default(cuid())
  name      String         @unique
  category  String         @default("Lainnya")
  order     Int            @default(0)
  projects  ProjectSkill[]
}

/// Join eksplisit supaya urutan techStack per project bisa diatur.
/// Relasi many-to-many implisit tidak punya kolom order sendiri.
model ProjectSkill {
  projectId String
  skillId   String
  order     Int    @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
}

model Experience {
  id      String @id @default(cuid())
  company String
  role    Json // Localized
  period  Json // Localized
  bullets Json // LocalizedList
  order   Int    @default(0)
}

model SiteSetting {
  id          String  @id @default("singleton")
  siteTitle   String
  description Json? // Localized
  ogImage     String?
  favicon     String?
  /// URL absolut situs, dipakai sebagai base URL untuk metadata Open Graph.
  siteUrl     String?
}
